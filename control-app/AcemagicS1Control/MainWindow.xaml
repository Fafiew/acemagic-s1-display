<Window x:Class="AcemagicS1Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACEMAGIC S1 Display Control" Height="640" Width="880"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ACEMAGIC S1 Extended Display"
                   FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Driver" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DriverStatus}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="USB LCD" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsbStatus}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Renderer" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RendererStatus}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Resolution" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Resolution}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="FPS (sent/prod)" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Fps}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Dropped" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Drops}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Start" Command="{Binding StartRendererCommand}"
                                Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Stop" Command="{Binding StopRendererCommand}"
                                Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Restart" Command="{Binding RestartRendererCommand}"
                                Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Reconnect" Command="{Binding ReconnectCommand}"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Start renderer with this app" IsChecked="{Binding StartRendererWithApp}"
                              Margin="0,4"/>
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                              Margin="0,4"/>
                    <CheckBox Content="Auto-reconnect USB" IsChecked="{Binding AutoReconnect}"
                              Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Target FPS" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding TargetFps}" Width="60"/>
                    </StackPanel>
                    <Button Content="Export diagnostics" Command="{Binding ExportLogsCommand}"
                            Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log / device list -->
        <TabControl Grid.Row="2" Margin="0,12,0,0" Background="Transparent" BorderBrush="{StaticResource MutedBrush}">
            <TabItem Header="Log">
                <ListBox ItemsSource="{Binding Log}" Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource FgBrush}" FontFamily="Consolas" FontSize="12"/>
            </TabItem>
            <TabItem Header="HID devices">
                <ListBox ItemsSource="{Binding HidDevices}" Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource FgBrush}" FontFamily="Consolas" FontSize="12"/>
            </TabItem>
            <TabItem Header="Help">
                <ScrollViewer Background="{StaticResource PanelBrush}" Padding="12">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgBrush}">
                        1. Install the driver (see docs/installation.md). The virtual monitor appears
                        in Settings &#x2192; System &#x2192; Display as "ACEMAGIC S1 Front LCD".
                        {"\n\n"}
                        2. Choose "Extend these displays" and drag the S1 monitor into position.
                        {"\n\n"}
                        3. Move a window onto the S1 display; its content is transmitted to the
                        physical LCD by the renderer.
                        {"\n\n"}
                        If the LCD does not update, make sure CYXTFTTool is not running (it holds the
                        HID interface), then press Restart.
                    </TextBlock>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="Frame content is ordinary Windows desktop output; this app does not generate dashboards."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
